# Learnyt — server-side only. Copy to .env and fill values.
# Never expose these in frontend JS, HTML, CSS, or query params.

APP_NAME=Learnyt
APP_URL=http://localhost:8080
APP_DEBUG=true

# Optional: YouTube Data API (server-side metadata only)
# YOUTUBE_API_KEY=

# Optional: path overrides
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
